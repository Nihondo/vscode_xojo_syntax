{
	"name": "xojo-syntax",
	"displayName": "Xojo Syntax Support",
	"description": "Xojo language support: highlighting, Outline, workspace symbol search, folding, color previews, editing helpers, and library API browsing.",
	"version": "1.0.0",
	"publisher": "nihondo",
	"license": "MIT",
	"engines": {
		"vscode": "^1.70.0"
	},
	"icon": "images/icon.png",
	"main": "./extension.js",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"xojo",
		"basic",
		"syntax",
		"outline",
		"tmLanguage"
	],
	"contributes": {
		"debuggers": [
			{
				"type": "xojo",
				"label": "Xojo",
				"program": "./extension.js",
				"configurationAttributes": {
					"launch": {
						"properties": {
							"runMode": {
								"type": "string",
								"enum": ["auto", "agentic", "legacy"],
								"description": "Override xojo.run.mode. Auto uses the Agentic file protocol when the manifest has AgenticMode=True; otherwise use macOS shortcuts."
							},
							"projectPath": {
								"type": "string",
								"description": "Path to a .xojo_project file, absolute or relative to the launch workspace folder."
							},
							"openProject": {
								"type": "boolean",
								"default": true,
								"description": "Open the selected project in Xojo on macOS before running. On other platforms open it manually."
							},
							"openDelayMs": {
								"type": "number", "minimum": 0, "default": 800,
								"description": "Wait after opening Xojo on macOS."
							},
							"reloadDialogDelayMs": {
								"type": "number", "minimum": 0, "default": 300,
								"description": "Legacy mode: wait before confirming the reload dialog."
							},
							"reloadToRunDelayMs": {
								"type": "number", "minimum": 0, "default": 500,
								"description": "Legacy mode: wait between reloading and running."
							},
							"agenticTimeoutMs": {
								"type": "number", "minimum": 1, "default": 30000,
								"description": "Agentic mode: maximum wait for Xojo to consume the run request."
							},
							"agenticErrorWaitMs": {
								"type": "number", "minimum": 0, "default": 10000,
								"description": "Agentic mode: observe compile error output after the request is consumed. This is not a build completion signal."
							}
						}
					}
				}
			}
		],
		"configuration": {
			"title": "Xojo",
			"properties": {
				"xojo.run.mode": {
					"type": "string",
					"enum": ["auto", "agentic", "legacy"],
					"default": "auto",
					"scope": "resource",
					"description": "Run protocol. Auto reads AgenticMode=True from the selected project. Agentic requires Xojo 2026r3+ with the project open in Agentic Mode. Legacy uses macOS shortcuts."
				}
			}
		},
		"commands": [
			{
				"command": "xojo.reloadAndRun",
				"title": "Xojo: Reload and Run"
			},
			{
				"command": "xojo.createDefaultLaunch",
				"title": "Xojo: Create Default launch.json"
			},
			{
				"command": "xojo.openLibraryApiFile",
				"title": "Xojo: Open Library API File"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "xojo.openLibraryApiFile",
					"when": "resourceExtname == .xojo_library",
					"group": "navigation"
				}
			]
		},
		"languages": [
			{
				"id": "xojo",
				"aliases": [
					"Xojo",
					"xojo"
				],
				"extensions": [
					".xojo_code",
					".xojo_script",
					".xojo_window",
					".xojo_menu"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "xojo",
				"scopeName": "source.xojo",
				"path": "./syntaxes/xojo.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "xojo",
				"path": "./snippets/xojo.json"
			}
		]
	},
	"activationEvents": [
		"onLanguage:xojo",
		"onCommand:xojo.reloadAndRun",
		"onCommand:xojo.createDefaultLaunch",
		"onCommand:xojo.openLibraryApiFile",
		"onDebug:xojo",
		"workspaceContains:**/*.{xojo_code,xojo_script,xojo_window,xojo_menu}"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Nihondo/vscode_xojo_syntax.git"
	},
	"scripts": {
		"test": "node --test test/*.test.js"
	},
	"devDependencies": {
		"@vscode/vsce": "^4.1.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2"
	}
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Xojo",
  "scopeName": "source.xojo",
  "patterns": [
    {
      "include": "#notes"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#layout"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.xojo",
          "match": "'.*$"
        },
        {
          "name": "comment.line.double-slash.xojo",
          "match": "//.*$"
        },
        {
          "name": "comment.line.rem.xojo",
          "match": "(?i)(?<![^\\s:])Rem(?=\\s|$).*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xojo",
          "begin": "\"",
          "end": "\"(?!\")|$",
          "patterns": [
            {
              "name": "constant.character.escape.xojo",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "metadata-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.metadata.xojo",
          "begin": "\"",
          "end": "\"(?!\")|$",
          "patterns": [
            {
              "name": "constant.character.escape.metadata.xojo",
              "match": "\\\\(?:x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|.)"
            },
            {
              "name": "constant.character.escape.xojo",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "comment.line.metadata.xojo",
          "match": "(?i)^\\s*#tag\\b.*$"
        }
      ]
    },
    "notes": {
      "patterns": [
        {
          "name": "comment.block.documentation.xojo",
          "begin": "(?i)^\\s*(#tag)\\s+(Note)\\b",
          "end": "(?i)^\\s*(#tag)\\s+(EndNote)\\b"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.xojo",
          "match": "(?i)#(?:If|ElseIf|Else|End\\s*If|Pragma)\\b"
        },
        {
          "name": "support.constant.target.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(DebugBuild|Target32Bit|Target64Bit|TargetAndroid|TargetARM|TargetBigEndian|TargetConsole|TargetDesktop|TargetiOS|TargetLinux|TargetLittleEndian|TargetMacOS|TargetMachO|TargetMobile|TargetMobileDevice|TargetMobileSimulator|TargetRemoteDebugger|TargetWeb|TargetWindows|TargetX86|TargetXojoCloud|XojoVersion|XojoVersionString)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.xojo",
          "match": "(?i)&h[0-9a-f]+(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "constant.numeric.binary.xojo",
          "match": "(?i)&b[01]+(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "constant.numeric.octal.xojo",
          "match": "(?i)&o[0-7]+(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "constant.other.color.xojo",
          "match": "(?i)&c[ \\t]*[0-9a-f]{2}(?:[ \\t]*[0-9a-f]{2}){2,3}(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "constant.character.unicode.xojo",
          "match": "(?i)&u[0-9a-f]{1,6}(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "constant.numeric.float.xojo",
          "match": "(?i)(?<![\\w.])(?:(?:\\d+\\.\\d*|\\.\\d+)(?:e[+-]?\\d+)?|\\d+e[+-]?\\d+)(?![\\w.])"
        },
        {
          "name": "constant.numeric.integer.xojo",
          "match": "(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])\\d+(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(True|False|Nil)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "variable.language.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(Self|Super|Me)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(And|Or|Not|Xor|Mod|IsA|Is)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "keyword.operator.symbol.xojo",
          "match": "<>|<=|>=|[+*/\\\\^=<>:\\-]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(ElseIf|If|Then|Else|End|For|Each|In|To|DownTo|Step|Next|While|Wend|Do|Loop|Until|Select|Case|Try|Catch|Finally|Raise|Return|Break|Continue|Exit|GoTo|Call)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "storage.modifier.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(Private|Public|Protected|Global|Shared|Static|ByRef|ByVal|Optional|ParamArray|Assigns|Extends|Inherits|Implements|Handles|Soft|Lib|Alias|Selector)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        },
        {
          "name": "keyword.declaration.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(Function|Sub|Method|Event|Class|Module|Structure|Interface|Enum|Delegate|Declare|Property|ComputedProperty|Get|Set|AddHandler|RemoveHandler|RaiseEvent|Using|New|Redim|Dim|Var|Const|As)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(Boolean|Integer|Int8|Int16|Int32|Int64|UInteger|UInt8|UInt16|UInt32|UInt64|Byte|Single|Double|String|CString|PString|WString|CFStringRef|CGFloat|OSType|Text|Variant|Auto|Date|DateTime|Color|Currency|Ptr|Object|Dictionary|Array)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])"
        }
      ]
    },
    "parentheses": {
      "patterns": [
        {
          "name": "meta.group.xojo",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#parentheses"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#types"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "name": "variable.parameter.xojo",
              "match": "[A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*(?=\\s*(?:\\([^)]*\\))?\\s+As\\b)"
            },
            {
              "name": "punctuation.separator.comma.xojo",
              "match": ","
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.xojo",
          "begin": "(?i)^\\s*((?:(?:Private|Public|Protected|Global|Shared|Static|Delegate|Soft|Declare)\\s+)*)(Sub|Function|Method|Event)\\s+([A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*(?:\\.[A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*)*)",
          "beginCaptures": {
            "1": {
              "name": "storage.modifier.xojo"
            },
            "2": {
              "name": "keyword.declaration.xojo"
            },
            "3": {
              "name": "entity.name.function.xojo"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#parentheses"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#types"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "name": "meta.type.declaration.xojo",
          "match": "(?i)^\\s*((?:(?:Private|Public|Protected|Global)\\s+)*)(Class|Module|Interface|Structure|Enum)\\s+([A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.xojo"
            },
            "2": {
              "name": "keyword.declaration.xojo"
            },
            "3": {
              "name": "entity.name.type.xojo"
            }
          }
        },
        {
          "name": "meta.constant.declaration.xojo",
          "match": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(Const)\\s+([A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.const.xojo"
            },
            "2": {
              "name": "variable.other.constant.xojo"
            }
          }
        },
        {
          "name": "meta.variable.declaration.xojo",
          "begin": "(?i)(?<![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])(Var|Dim)(?![A-Za-z0-9_\\x{0080}-\\x{10FFFF}])",
          "beginCaptures": {
            "1": {
              "name": "storage.type.modifier.xojo"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#types"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "name": "variable.other.declaration.xojo",
              "match": "[A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*(?=\\s*(?:\\([^)]*\\))?\\s*(?:,|As\\b|=))"
            },
            {
              "include": "#parentheses"
            }
          ]
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.xojo",
          "match": "[A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*(?:\\.[A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*)*(?=\\s*\\()"
        }
      ]
    },
    "layout": {
      "patterns": [
        {
          "name": "meta.layout.xojo",
          "begin": "(?i)^\\s*(Begin)\\s+([A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*(?:\\.[A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*)*)\\s+([A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.layout.xojo"
            },
            "2": {
              "name": "support.type.xojo"
            },
            "3": {
              "name": "entity.name.control.xojo"
            }
          },
          "end": "(?i)^\\s*(End)\\s*$",
          "endCaptures": {
            "1": {
              "name": "keyword.other.layout.xojo"
            }
          },
          "patterns": [
            {
              "include": "#layout"
            },
            {
              "include": "#tags"
            },
            {
              "include": "#metadata-strings"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#operators"
            },
            {
              "name": "entity.other.attribute-name.xojo",
              "match": "[A-Za-z_][A-Za-z0-9_\\x{0080}-\\x{10FFFF}]*(?=\\s*=)"
            }
          ]
        }
      ]
    }
  }
}
